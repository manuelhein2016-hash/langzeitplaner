{
  "name": "langzeitplaner",
  "version": "2.0.0",
  "private": true,
  "description": "Rolling 12-month whiteboard calendar for macOS — Jahresplaner poster, digitised.",
  "type": "module",
  "scripts": {
    "test": "node --test --import ./tests/helpers/dev-flag.mjs \"tests/tier1/*.test.js\"",
    "test:watch": "node --test --watch --import ./tests/helpers/dev-flag.mjs \"tests/tier1/*.test.js\"",
    "test:property": "node --test --import ./tests/helpers/dev-flag.mjs \"tests/property/*.test.js\"",
    "test:attack": "node --test --import ./tests/helpers/dev-flag.mjs \"tests/attack/*.test.js\"",
    "test:server": "node --test --import ./tests/helpers/dev-flag.mjs \"tests/server/*.test.js\"",
    "test:fleet": "node --test --import ./tests/helpers/dev-flag.mjs \"tests/fleet/*.test.js\"",
    "test:dom": "./tests/run-dom-tests.sh",
    "test:all": "npm test && npm run test:property && npm run test:attack && npm run test:server && npm run test:fleet && npm run test:dom",
    "dev": "node dev-server.mjs",
    "dev:server": "node server/dev-server.mjs",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2"
  }
}
