{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "LangzeitPlaner",
  "version": "1.0.0",
  "identifier": "org.langzeitplaner.app",
  "build": {
    "frontendDist": "../",
    "devUrl": "http://localhost:4173",
    "beforeDevCommand": "node dev-server.mjs"
  },
  "app": {
    "windows": [
      {
        "title": "LangzeitPlaner",
        "width": 1440,
        "height": 900,
        "minWidth": 900,
        "minHeight": 640,
        "resizable": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost"
    },
    "macOSPrivateApi": false
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "icon": ["icons/icon.icns"],
    "macOS": {
      "minimumSystemVersion": "12.0"
    }
  },
  "plugins": {}
}
