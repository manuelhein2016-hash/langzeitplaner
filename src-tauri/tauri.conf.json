{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "LangzeitPlaner",
  "version": "../package.json",
  "identifier": "org.langzeitplaner.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:4173",
    "beforeDevCommand": "node dev-server.mjs",
    "beforeBuildCommand": "node scripts/build-frontend.mjs"
  },
  "app": {
    "windows": [
      {
        "title": "LangzeitPlaner",
        "width": 1440,
        "height": 900,
        "minWidth": 900,
        "minHeight": 640,
        "resizable": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "center": true
      }
    ],
    "withGlobalTauri": true,
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost"
    },
    "macOSPrivateApi": false
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg"
    ],
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/icon.icns"
    ],
    "resources": [],
    "macOS": {
      "minimumSystemVersion": "12.0",
      "dmg": {
        "background": "dmg/background.tiff",
        "windowSize": {
          "width": 660,
          "height": 420
        },
        "appPosition": {
          "x": 170,
          "y": 170
        },
        "applicationFolderPosition": {
          "x": 490,
          "y": 170
        }
      }
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/OWNER/REPO/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDU5MjIzMUQ4QTQ0OUI2QUIKUldTcnRrbWsyREVpV1FBZzBIaDFhY3lHQzRWbnNHckRpV0dMa0lBeXNwcXNZdzN0L3ZRaGNCejAK"
    }
  }
}
